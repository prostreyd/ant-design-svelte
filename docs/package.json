{
  "name": "svelte-ant-design-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site of svelte-ant-design (SvelteKit, prerendered for GitHub Pages).",
  "imports": {
    "#docs/*": "./src/docs/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve-build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "axe-core": "^4.10.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
