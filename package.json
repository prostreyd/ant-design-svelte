{
  "name": "svelte-ant-design",
  "version": "0.4.1",
  "description": "An independent UI component library for Svelte 5, inspired by Ant Design.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prostreyd/ant-design-svelte.git"
  },
  "homepage": "https://prostreyd.github.io/ant-design-svelte/",
  "bugs": {
    "url": "https://github.com/prostreyd/ant-design-svelte/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "ui",
    "components",
    "component-library",
    "ant-design",
    "typescript",
    "accessibility",
    "antd",
    "design-system",
    "ui-library"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "docs"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens-accessible.css": "./dist/tokens-accessible.css"
  },
  "scripts": {
    "dev": "npm run dev -w docs",
    "build": "npm run build -w docs",
    "preview": "npm run preview -w docs",
    "package": "svelte-package",
    "prepublishOnly": "npm run lint && npm run check && npm run test && npm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:docs": "npm run check -w docs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docs": "npm run verify -w docs && npm run test:e2e -w docs",
    "test:mutation": "node scripts/mutation-test.mjs",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.10.3",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
